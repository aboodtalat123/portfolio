@inject NavigationManager Navigation

<header class="site-header" aria-label="@T("Primary navigation", "التنقل الرئيسي")">
    <div class="page-shell site-header__inner">
        <a class="brand" href="@HomeLink("#top")" aria-label="@T("ABD ALRAHMAN TALAT ABUSALEM - home", "عبد الرحمن أبو سالم - الرئيسية")">
            <span class="brand-symbol" aria-hidden="true">T</span>
            <span class="brand-copy">
                <strong>TalatAI</strong>
                <small>@T("APPLIED AI ENGINEERING", "هندسة الذكاء الاصطناعي")</small>
            </span>
        </a>

        <nav class="main-nav" aria-label="@T("Main navigation", "التنقل الرئيسي")">
            <a href="@HomeLink("#system")">@T("Innovation", "الابتكار")</a>
            <a href="@HomeLink("#work")">@T("Products", "المشاريع")</a>
            <a href="@HomeLink("#about")">@T("Profile", "عني")</a>
        </nav>

        <div class="header-actions">
            <div class="preference-controls" aria-label="@T("Display preferences", "خيارات العرض")">
                <a class="language-toggle" href="@LanguageUrl" data-language-toggle data-language="@(IsArabic ? "en" : "ar")"
                   lang="@(IsArabic ? "en" : "ar")"
                   aria-label="@T("عرض الموقع بالعربية", "View the website in English")"
                   title="@T("عرض الموقع بالعربية", "View the website in English")">
                    <span>@(IsArabic ? "EN" : "AR")</span>
                </a>
                <button class="theme-toggle" type="button" data-theme-toggle
                        aria-label="@T("Switch color theme", "تبديل سمة الألوان")"
                        title="@T("Switch color theme", "تبديل سمة الألوان")">
                    <svg class="theme-icon theme-icon-dark" aria-hidden="true" viewBox="0 0 24 24"><path d="M20.2 15.3A8.5 8.5 0 0 1 8.7 3.8 8.5 8.5 0 1 0 20.2 15.3Z" /></svg>
                    <svg class="theme-icon theme-icon-light" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.5" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                </button>
            </div>
            <a class="header-cta" href="mailto:aboodtalat123@gmail.com">@T("Let's talk", "لنتواصل") <span aria-hidden="true">↗</span></a>
        </div>
    </div>
</header>

@code {
    [Parameter]
    public string Culture { get; set; } = "en";

    private bool IsArabic => string.Equals(Culture, "ar", StringComparison.OrdinalIgnoreCase);

    private string LanguageUrl
    {
        get
        {
            var current = new Uri(Navigation.Uri);
            return IsArabic ? current.AbsolutePath : $"{current.AbsolutePath}?lang=ar";
        }
    }

    private string T(string english, string arabic) => IsArabic ? arabic : english;

    private string HomeLink(string fragment) => IsArabic ? $"/?lang=ar{fragment}" : $"/{fragment}";
}
