    private IReadOnlyList<ProjectLink> GetLinks(ProjectDetail item)
    {
        var links = new List<ProjectLink>();
        if (!string.IsNullOrWhiteSpace(item.PreviewUrl))
        {
            links.Add(new ProjectLink(T("Open live product", "فتح المنتج الحي"), item.PreviewUrl, true, true));
        }

        if (!string.IsNullOrWhiteSpace(item.RepositoryUrl))
        {
            var repositoryLabel = item.Slug == "reusable-site-ai"
                ? T("University adapter", "محول الجامعة")
                : T("View repository", "عرض المستودع");
            links.Add(new ProjectLink(repositoryLabel, item.RepositoryUrl, true, links.Count == 0));
        }

        if (item.Slug == "reusable-site-ai")
        {
            links.Add(new ProjectLink(T("View GitHub profile", "عرض حساب GitHub"), "https://github.com/aboodtalat123", true, true));
            links.Add(new ProjectLink(T("Request source access", "طلب الوصول إلى المصدر"), "mailto:aboodtalat123@gmail.com?subject=Site-aware%20AI%20source%20access", false));
        }

        return links;
    }

