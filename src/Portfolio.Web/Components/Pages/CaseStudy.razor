@page "/work/{Slug}"
@inject IProjectRepository ProjectRepository

<PageTitle>@(study is not null ? $"{study.Title} | TalatAI" : project is null ? T("Project not found", "المشروع غير موجود") : $"{project.Title} | {T("ABD ALRAHMAN TALAT ABUSALEM", "عبد الرحمن أبو سالم")}")</PageTitle>
<HeadContent>
    <meta name="description" content="@(study?.Summary.In(Culture) ?? project?.Summary ?? T("Project case study by ABD ALRAHMAN TALAT ABUSALEM", "دراسة حالة لمشروع من تطوير عبد الرحمن أبو سالم"))" />
    <meta property="og:title" content="@(project is null ? T("Project case study", "دراسة حالة مشروع") : $"{project.Title} | {T("ABD ALRAHMAN TALAT ABUSALEM", "عبد الرحمن أبو سالم")}")" />
    <meta property="og:description" content="@(study?.Summary.In(Culture) ?? project?.Summary ?? T("Project case study by ABD ALRAHMAN TALAT ABUSALEM", "دراسة حالة لمشروع من تطوير عبد الرحمن أبو سالم"))" />
</HeadContent>

<div class="site-shell">
    <PortfolioHeader Culture="@Culture" />

    @if (study is not null)
    {
        <EditorialCase Study="study" Culture="@Culture" />
    }
    else if (project is null)
    {
        <main class="case-main page-shell">
            <section class="not-found-panel">
                <span>404 / @T("PROJECT NOT FOUND", "المشروع غير موجود")</span>
                <h1>@T("This case study does not exist.", "دراسة الحالة هذه غير موجودة.")</h1>
                <a class="button button-primary" href="@HomeWorkUrl">@T("Return to selected work", "العودة إلى الأعمال المختارة")</a>
            </section>
        </main>
    }
    else
    {
        var thumbnail = project.Media.FirstOrDefault(item => item.IsThumbnail) ?? project.Media.FirstOrDefault();
        var architecture = GetArchitecture(project.Slug);
        var principles = GetPrinciples(project.Slug);
        var evidence = GetEvidence(project.Slug);
        var links = GetLinks(project);
        var sectionOffset = evidence.Count > 0 ? 1 : 0;

        <main class="case-main">
            <section class="case-hero page-shell">
                <a class="breadcrumb" href="@HomeWorkUrl"><span>@(IsArabic ? "→" : "←")</span> @T("SELECTED WORK", "الأعمال المختارة")</a>
                <div class="case-hero__grid">
                    <div class="case-hero__copy">
                        <div class="project-meta"><span>@project.Category</span><span>@project.CompletedYear</span><span>@T("CASE STUDY", "دراسة حالة")</span></div>
                        <h1>@project.Title</h1>
                        <p>@project.Summary</p>
                        <div class="project-actions">
                            @foreach (var link in links)
                            {
                                <a class="@(link.Primary ? "button button-primary" : "button button-secondary")" href="@link.Url" target="@(link.External ? "_blank" : null)" rel="@(link.External ? "noreferrer" : null)">@link.Label <span aria-hidden="true">@(link.External ? "↗" : "→")</span></a>
                            }
                        </div>
                    </div>
                    <aside class="case-facts" aria-label="@T("Project facts", "حقائق المشروع")">
                        @foreach (var fact in GetFacts(project.Slug))
                        {
                            <div><span>@fact.Label</span><strong>@fact.Value</strong></div>
                        }
                    </aside>
                </div>
            </section>

            <section class="case-visual page-shell" aria-label="@T("Project preview", "معاينة المشروع")">
                <ProjectVisual Slug="@project.Slug" ImagePath="@thumbnail?.Path" AltText="@thumbnail?.AltText" Culture="@Culture" />
            </section>

            @if (evidence.Count > 0)
            {
                <section class="case-evidence page-shell" aria-labelledby="evidence-title">
                    <header class="case-section-heading"><span>01</span><div><p>@T("WORKING PRODUCT EVIDENCE", "دليل منتج يعمل فعليًا")</p><h2 id="evidence-title">@T("Real interfaces, not mockups.", "واجهات حقيقية وليست نماذج وهمية.")</h2></div></header>
                    <div class="case-evidence-grid @(evidence.Count > 2 ? "case-evidence-grid-wide" : string.Empty)">
                        @foreach (var item in evidence)
                        {
                            <figure class="evidence-shot">
                                <div class="real-screen"><img src="@item.Path" alt="@item.AltText" loading="lazy" /></div>
                                <figcaption><span>@item.Label</span><p>@item.Caption</p></figcaption>
                            </figure>
                        }
                    </div>
                </section>
            }

            <section class="case-story page-shell" aria-labelledby="story-title">
                <header class="case-section-heading"><span>@((1 + sectionOffset).ToString("00"))</span><div><p>@T("CONTEXT & DELIVERY", "السياق والتنفيذ")</p><h2 id="story-title">@T("The engineering story.", "القصة الهندسية.")</h2></div></header>
                <div class="story-grid">
                    <article><span>@T("THE CHALLENGE", "التحدي")</span><p>@project.Challenge</p></article>
                    <article><span>@T("THE SOLUTION", "الحل")</span><p>@project.Solution</p></article>
                    <article><span>@T("MY ROLE", "دوري")</span><p>@project.Role</p></article>
                    <article><span>@T("THE RESULT", "النتيجة")</span><p>@project.Outcome</p></article>
                </div>
            </section>

            <section class="case-architecture section-block" aria-labelledby="architecture-title">
                <div class="page-shell">
                    <header class="case-section-heading"><span>@((2 + sectionOffset).ToString("00"))</span><div><p>@T("SYSTEM DESIGN", "تصميم النظام")</p><h2 id="architecture-title">@T("How the product works.", "كيف يعمل المنتج.")</h2></div></header>
                    <div class="case-pipeline">
                        @{ var index = 0; }
                        @foreach (var item in architecture)
                        {
                            index++;
                            <article><span>@index.ToString("00")</span><div><strong>@item.Title</strong><p>@item.Description</p></div><code>@item.Tag</code></article>
                        }
                    </div>
                </div>
            </section>

            <section class="case-principles page-shell" aria-labelledby="principles-title">
                <header class="case-section-heading"><span>@((3 + sectionOffset).ToString("00"))</span><div><p>@T("ENGINEERING DECISIONS", "القرارات الهندسية")</p><h2 id="principles-title">@T("What keeps it trustworthy.", "ما الذي يجعله موثوقًا.")</h2></div></header>
                <div class="principle-grid">
                    @foreach (var item in principles)
                    {
                        <article><span>@item.Label</span><h3>@item.Title</h3><p>@item.Description</p></article>
                    }
                </div>
            </section>

            <section class="case-stack page-shell" aria-labelledby="stack-title">
                <div><p class="section-index">@((4 + sectionOffset).ToString("00")) / @T("TECHNOLOGY", "التقنيات")</p><h2 id="stack-title">@T("Tools chosen for the job.", "تقنيات اختيرت لخدمة المنتج.")</h2></div>
                <div class="tech-cloud">
                    @foreach (var technology in project.Technologies)
                    {
                        <span>@technology</span>
                    }
                </div>
            </section>

            <section class="next-project page-shell">
                <span>@T("NEXT CASE STUDY", "دراسة الحالة التالية")</span>
                <a href="@LocalUrl($"/work/{GetNextSlug(project.Slug)}")">@GetNextTitle(project.Slug) <b>@InlineArrow</b></a>
            </section>
        </main>
    }

    <PortfolioFooter Culture="@Culture" />
</div>

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "lang")]
    public string? Language { get; set; }

    private ProjectDetail? project;
    private WorkStudy? study => Editorial.Work.FirstOrDefault(item => string.Equals(item.Slug, Slug, StringComparison.OrdinalIgnoreCase));
    private string Culture => string.Equals(Language, "ar", StringComparison.OrdinalIgnoreCase) ? "ar" : "en";
    private bool IsArabic => Culture == "ar";
    private string InlineArrow => IsArabic ? "←" : "→";
    private string HomeWorkUrl => IsArabic ? "/?lang=ar#work" : "/#work";

    protected override async Task OnParametersSetAsync()
    {
        project = await ProjectRepository.GetBySlugAsync(Slug, Culture);
    }

    private sealed record Fact(string Label, string Value);
    private sealed record ArchitectureItem(string Title, string Description, string Tag);
    private sealed record Principle(string Label, string Title, string Description);
    private sealed record EvidenceMedia(string Path, string Label, string Caption, string AltText);
    private sealed record ProjectLink(string Label, string Url, bool External, bool Primary = false);

    private IReadOnlyList<Fact> GetFacts(string slug)
    {
        if (IsArabic)
        {
            return slug switch
            {
                "fairaid-gaza" => [new("المنصة", "عربية أولًا"), new("المسارات", "3 رحلات حسب الدور"), new("التسليم", "منتج ويب حي")],
                "reusable-site-ai" => [new("المحولات", "موقعان يعملان"), new("الوصول للبيانات", "دون قاعدة البيانات"), new("الأدلة", "مصادر صفحات دقيقة")],
                "dr-solution" => [new("الحالة", "منشور على Render"), new("الإصدار", "3.0.0"), new("الاختبارات", "8 ناجحة")],
                _ => [new("المدخلات", "فيديوهات وقوائم"), new("المخرجات", "تقارير منظمة"), new("النمط", "محلي أولًا")]
            };
        }

        return slug switch
        {
            "fairaid-gaza" => [new("PLATFORM", "Arabic-first"), new("WORKFLOWS", "3 role journeys"), new("DELIVERY", "Live web product")],
            "reusable-site-ai" => [new("ADAPTERS", "2 working sites"), new("DATA ACCESS", "No direct database"), new("EVIDENCE", "Exact page sources")],
            "dr-solution" => [new("STATUS", "Live on Render"), new("VERSION", "3.0.0"), new("TESTS", "8 passing")],
            _ => [new("INPUT", "Videos + playlists"), new("OUTPUT", "Structured reports"), new("MODE", "Local-first")]
        };
    }

    private IReadOnlyList<ArchitectureItem> GetArchitecture(string slug)
    {
        if (IsArabic)
        {
            return slug switch
            {
                "fairaid-gaza" =>
                [
                    new("دخول حسب الدور", "يدخل المواطن والمؤسسة والمسؤول عبر رحلات موثقة ومنفصلة.", "AUTH"),
                    new("عمليات متحقق منها", "تحمي قواعد التحقق وفحوصات طبقة الخدمات التسجيل وخطط التوزيع.", "RULES"),
                    new("فحص التعارض والسعة", "تُقارن الخطط ضمن نافذة 48 ساعة للمنطقة، وتحترم طلبات المواطنين السعة المتاحة.", "CHECK"),
                    new("تسليم قابل للتتبع", "تحفظ حالات الحضور والتسليم وسجل التدقيق والتحليلات أثرًا تشغيليًا واضحًا.", "DATA"),
                    new("مساعدة موثقة", "تجيب خدمة معرفة منفصلة من السياق العام والظاهر حسب الدور دون امتلاك قاعدة بيانات المنصة.", "AI")
                ],
                "reusable-site-ai" =>
                [
                    new("اكتشاف معرفة الموقع المتاحة", "يرسم محول الموقع المسارات والعناوين والروابط والحقول والجداول والعناصر والمحتوى المسموح دون دخول الخادم الخاص.", "MAP"),
                    new("قراءة الصفحة الحالية", "وقت السؤال تلتقط الإضافة ما يراه المستخدم المسجل الآن، فتفهم الإجابة المهمة الحية أمامه.", "DOM"),
                    new("التنقية والعزل", "تُحذف قيم الجلسات وحقول الروابط الحساسة، وتبقى بيانات SQLite ومتجهات Chroma داخل مساحة منفصلة لكل موقع ومستخدم.", "SAFE"),
                    new("الاسترجاع الحي أولًا", "يتقدم سياق الصفحة الحالية على النسخ المخزنة، ثم يضيف البحث الهجين أدلة من معرفة الموقع الأوسع.", "RAG"),
                    new("الإجابة والانتقال", "تتضمن الإجابة عنوان مصدر واضحًا وتفتح الصفحة الرسمية الدقيقة قبل استخدام المطابقة الاحتياطية للمسار.", "SOURCE")
                ],
                "dr-solution" =>
                [
                    new("استقبال المستند", "تتحقق الواجهة البرمجية من ملفات PDF والصور والحجم وعدد الصفحات ونمط الدراسة المختار.", "UPLOAD"),
                    new("استخراج الصفحة بصريًا", "يرسم PyMuPDF كل صفحة ويحفظ سياقها البصري بجانب النص المستخرج.", "PDF"),
                    new("تحليل متعدد الوسائط", "يحلل Gemini دفعات الصفحات للترجمة والشرح والصور والنقاط المهمة والخلاصات.", "AI"),
                    new("واجهة دراسة تفاعلية", "يعرض المتصفح سلايدات بصرية وسياق الفصول وأسئلة قابلة للضبط ومحادثة سياقية.", "UI"),
                    new("مخرجات قابلة للنقل", "ينشئ المصدر ملف HTML تفاعليًا واحدًا يعمل دون خادم التطبيق.", "EXPORT")
                ],
                _ =>
                [
                    new("استقبال الوسائط", "يقبل المسار المحلي فيديوهات وقوائم YouTube المدعومة للمعالجة.", "INPUT"),
                    new("أخذ عينات الإطارات", "يستخرج FFmpeg إطارات ممثلة من الخط الزمني.", "FRAMES"),
                    new("النص والرؤية", "يقرأ OCR أو التحليل البصري أهداف التعلم العربية والإنجليزية من الشرائح المفيدة.", "OCR"),
                    new("إزالة التكرار", "تُخفض الإطارات والأهداف المتكررة قبل التصدير.", "CLEAN"),
                    new("تقرير منظم", "تُنظم النتيجة النهائية للمراجعة بدل بقائها مدفونة في خط الفيديو الزمني.", "REPORT")
                ]
            };
        }

        return slug switch
        {
            "fairaid-gaza" =>
            [
                new("Role-aware entry", "Citizens, organizations, and administrators enter separate authenticated journeys.", "AUTH"),
                new("Validated operations", "Fluent validation and service-layer checks protect registrations and distribution plans.", "RULES"),
                new("Conflict and capacity checks", "Plans are compared inside a 48-hour sector window; citizen requests respect available capacity.", "CHECK"),
                new("Tracked delivery", "Attendance, delivery state, audit events, and analytics preserve an operational trail.", "DATA"),
                new("Grounded assistance", "A separate knowledge service answers from public and role-visible context without owning the platform database.", "AI")
            ],
            "reusable-site-ai" =>
            [
                new("Discover accessible site knowledge", "A site adapter maps allowed routes, titles, links, fields, tables, controls, and meaningful content without entering the private backend.", "MAP"),
                new("Read the current page", "At question time the extension captures what the signed-in user can currently see, so the answer understands the live task in front of them.", "DOM"),
                new("Sanitize and isolate", "Session values and sensitive URL fields are removed, while SQLite metadata and Chroma vectors stay inside a separate site and user workspace.", "SAFE"),
                new("Retrieve live-first", "Current-page context outranks stored copies, then hybrid search adds supporting evidence from the wider site knowledge base.", "RAG"),
                new("Answer and navigate", "The response includes a recognizable source title and opens the exact canonical page before a route-level fallback is considered.", "SOURCE")
            ],
            "dr-solution" =>
            [
                new("Document intake", "The API validates PDF and image inputs, size limits, page limits, and the selected study mode.", "UPLOAD"),
                new("Visual page extraction", "PyMuPDF renders each page and preserves the image context alongside extracted text.", "PDF"),
                new("Multimodal analysis", "Gemini analyzes page batches for translation, explanation, imagery, key points, and summaries.", "AI"),
                new("Interactive study view", "The browser renders visual slides, chapter context, configurable questions, and contextual chat.", "UI"),
                new("Portable output", "The exporter creates a single interactive HTML file that can be opened without the application server.", "EXPORT")
            ],
            _ =>
            [
                new("Media intake", "The local workflow accepts supported YouTube videos and playlists for processing.", "INPUT"),
                new("Frame sampling", "FFmpeg extracts representative frames from the timeline.", "FRAMES"),
                new("Text and vision", "OCR or vision analysis reads Arabic and English learning goals from useful slide frames.", "OCR"),
                new("Deduplication", "Repeated frames and repeated goals are reduced before export.", "CLEAN"),
                new("Structured report", "The final result is organized for review instead of remaining buried inside video timelines.", "REPORT")
            ]
        };
    }

    private IReadOnlyList<EvidenceMedia> GetEvidence(string slug)
    {
        if (IsArabic)
        {
            return slug switch
            {
            "reusable-site-ai" =>
            [
                new("/media/projects/site-ai-adapters.png", "المحولات · تطبيقات متعددة", "تظهر النواة نفسها وهي تعمل على بوابة جامعة ومنصة تعليمية معزولتين.", "مساعد ذكاء مدرك للموقع يعمل على بوابة جامعة ومنصة طاقات"),
                new("/media/projects/university-site.png", "الجامعة · البوابة الأصلية", "تبقى بوابة Oracle APEX الموثقة هي مصدر الحقيقة وتحافظ على صلاحياتها الحالية.", "بوابة الجامعة بعد تسجيل الدخول وقبل فتح مساعد الذكاء"),
                new("/media/projects/university-ai-assistant.png", "الجامعة · سياق الصفحة الحي", "يتعرف المساعد إلى المستخدم المسجل ويشرح المعلومات من الصفحة المفتوحة حاليًا.", "بوابة الجامعة مع مساعد يستخدم سياق الصفحة الحية"),
                new("/media/projects/university-ai-navigation.png", "الجامعة · انتقال دقيق", "تقدم الإجابة الموثقة خطوات عملية وتعرض الصفحة ذات الصلة كمصدر قابل للفتح.", "مساعد الجامعة يقدم خطوات وانتقالًا دقيقًا للمصدر"),
                new("/media/projects/taqat-ai-assistant.png", "طاقات · المحول الثاني", "تعمل النواة نفسها مع منصة تعليمية وواجهة وبنية معرفة مختلفة.", "أكاديمية طاقات مع مساعد الذكاء القابل لإعادة الاستخدام")
            ],
            "dr-solution" =>
            [
                new("/media/projects/dr-solution-workspace-showcase.png", "تجربة الدراسة · مساحة تحليل", "تعرض المنصة مساحة رفع الملفات وإعدادات التحليل داخل واجهة عربية منشورة.", "Dr. Solution على شاشة حاسوب مع مساحة تحليل الملفات"),
                new("/media/projects/dr-solution-live.png", "منتج حي · الإصدار 3.0.0", "تستقبل مساحة الدراسة العربية المنشورة ملفات PDF والصور وتقدم خيارات للتحليل والاختبارات.", "مساحة تحليل الملفات الأكاديمية الحية في Dr. Solution"),
                new("/media/projects/dr-solution-ai-chat.png", "محادثة ذكاء سياقية", "يجيب المساعد المدمج من مساحة الدراسة والتحليل الظاهر للمتعلم حاليًا.", "Dr. Solution مع لوحة المحادثة السياقية مفتوحة")
            ],
                _ => []
            };
        }

        return slug switch
        {
            "reusable-site-ai" =>
            [
                new("/media/projects/site-ai-adapters.png", "ADAPTERS · MULTIPLE PRODUCTS", "The same core is shown running against a university portal and a learning platform with isolated adapters.", "Site-aware AI assistant running on a university portal and Taqat Academy"),
                new("/media/projects/university-site.png", "UNIVERSITY · BASE PORTAL", "The authenticated Oracle APEX portal remains the source of truth and keeps its existing permissions.", "Authenticated university portal before opening the AI assistant"),
                new("/media/projects/university-ai-assistant.png", "UNIVERSITY · LIVE PAGE CONTEXT", "The assistant identifies the signed-in user and explains information from the page currently open.", "University portal with the AI assistant using live page context"),
                new("/media/projects/university-ai-navigation.png", "UNIVERSITY · EXACT NAVIGATION", "A grounded answer gives practical steps and exposes the relevant page as an actionable source.", "University AI assistant giving steps and exact page navigation"),
                new("/media/projects/taqat-ai-assistant.png", "TAQAT · SECOND ADAPTER", "The same core runs against a different learning platform, interface, and knowledge structure.", "Taqat Academy with the reusable AI assistant integrated")
            ],
            "dr-solution" =>
            [
                new("/media/projects/dr-solution-workspace-showcase.png", "STUDY EXPERIENCE · ANALYSIS WORKSPACE", "The platform shows file upload, explanation controls, quiz settings, and contextual assistance in a live Arabic interface.", "Dr. Solution on a laptop with the academic file analysis workspace"),
                new("/media/projects/dr-solution-live.png", "LIVE PRODUCT · VERSION 3.0.0", "The deployed Arabic study workspace accepts PDFs and images and exposes configurable analysis and quiz controls.", "Live Dr. Solution academic file analysis workspace"),
                new("/media/projects/dr-solution-ai-chat.png", "CONTEXTUAL AI CHAT", "The built-in assistant can answer from the study workspace and the analysis currently visible to the learner.", "Dr. Solution with its contextual AI chat panel open")
            ],
            _ => []
        };
    }

    private IReadOnlyList<Principle> GetPrinciples(string slug)
    {
        if (IsArabic)
        {
            return slug switch
            {
                "fairaid-gaza" =>
                [
                    new("النزاهة", "قواعد العمل داخل الخدمات", "تُركز فحوصات التسجيل والسعة والتعارض بدل تكرارها في الصفحات."),
                    new("التتبع", "الإجراءات المهمة تترك دليلًا", "تجعل سجلات التدقيق والحالات الواضحة التغييرات التشغيلية قابلة للمراجعة."),
                    new("التسليم", "منتج واحد ورحلات متعددة", "تتغير الواجهة حسب الدور بينما يبقى نموذج المجال متسقًا.")
                ],
                "reusable-site-ai" =>
                [
                    new("الخصوصية", "لا يجمع كلمات المرور", "يسجل المستخدم دخوله إلى الموقع بالطريقة المعتادة ويعمل المساعد داخل الجلسة الحالية."),
                    new("العزل", "مساحة مستقلة لكل تثبيت", "تشترك عمليات تخزين الصفحات واسترجاعها وحذفها والبحث المتجهي في حدود المساحة نفسها."),
                    new("الأدلة", "المصادر قابلة للاستخدام", "تتضمن الإجابات انتقالًا إلى الصفحة الدقيقة بدل نص مولد لا يمكن التحقق منه.")
                ],
                "dr-solution" =>
                [
                    new("أمان المفتاح", "المستخدم يقدم مفتاحه", "يُستخدم المفتاح للطلب ويُستبعد من السجل المحلي والملفات المصدرة."),
