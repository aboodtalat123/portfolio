@page "/"
<PageTitle>@Editorial.Identity.In(Culture) · TalatAI</PageTitle>
<PortfolioHeader Culture="@Culture" />
<main id="top" class="v2">
    <section class="page-shell v2-hero">
        <div>
            <p class="v2-label">TalatAI <span> / </span> @T("Engineering portfolio", "ملف الأعمال الهندسية")</p>
            <h1>@Editorial.Identity.In(Culture)</h1>
            <p class="v2-role">@Editorial.Profession.In(Culture)</p>
            <p class="v2-founder">@T("Founder of TalatAI / SiteAware AI", "مؤسس TalatAI / SiteAware AI")</p>
            <p class="v2-lead">@Editorial.Bio.In(Culture)</p>
            <div class="project-actions"><a class="button button-primary" href="@(Url("/") + "#work")">@T("Explore the work", "استكشف الأعمال")</a><a class="button button-secondary" href="@Url("/cv")">@T("View CV", "السيرة الذاتية")</a></div>
        </div>
        <button type="button" class="v2-portrait" data-open-portfolio-assistant aria-controls="portfolio-assistant-panel" aria-expanded="false">
            <img src="/media/portrait.webp" alt="" width="820" height="779" fetchpriority="high" />
            <span><i aria-hidden="true"></i> @T("Ask my AI representative", "اسأل ممثلي بالذكاء الاصطناعي") <b aria-hidden="true">↗</b></span>
        </button>
    </section>
    <section class="v2-feature" id="system">
        <div class="page-shell v2-feature-inner">
            <div>
                <p class="v2-label">@T("Flagship project", "المشروع الرئيسي")</p>
                <h2>SiteAware AI</h2>
                <p class="v2-lead">@Editorial.Work[0].Summary.In(Culture)</p>
                <div class="project-actions"><a class="button button-primary" href="@Url(Editorial.Work[0].Path)">@T("Read case study", "اقرأ دراسة الحالة")</a><a class="button button-secondary" href="@Url("/pitch")">@T("Open pitch", "افتح العرض")</a></div>
            </div>
            <ol class="v2-flow" aria-label="@T("Application intelligence architecture", "هندسة ذكاء التطبيقات")">
                <li>@T("Observe authorized interfaces", "رصد الواجهات المصرح بها")</li>
                <li>@T("Learn pages, routes and goals", "تعلم الصفحات والمسارات والأهداف")</li>
                <li>@T("Retrieve approved evidence", "استرجاع الأدلة المعتمدة")</li>
                <li>@T("Give verified guidance", "تقديم إرشاد متحقق")</li>
            </ol>
        </div>
    </section>
    <section class="page-shell v2-section" id="work">
        <h2>@T("Selected work", "أعمال مختارة")</h2>
        @foreach (var study in Editorial.Work.Skip(1))
        {
            <a class="v2-work-row" href="@Url(study.Path)">
                <strong>@study.Title</strong><span>@study.Summary.In(Culture)</span><b aria-hidden="true">↗</b>
            </a>
        }
    </section>
    <section class="page-shell v2-section v2-split" id="about">
        <h2>@T("Engineering practice", "الممارسة الهندسية")</h2>
        <div>
            <p class="v2-lead">@Editorial.Experience.In(Culture)</p>
            <p>Python · FastAPI · C# · ASP.NET Core · TypeScript · PostgreSQL · Playwright</p>
        </div>
    </section>
    <section class="page-shell v2-section v2-split" id="lab">
        <h2>@T("Engineering lab", "المختبر الهندسي")</h2>
        <div>@foreach(var item in Editorial.Lab)
        {
            @if (item.Url is { } target)
            {
                <a class="v2-lab-item" href="@Url(target)"><strong>@item.Title ↗</strong><span>@item.Description.In(Culture)</span></a>
            }
            else
            {
                <div class="v2-lab-item"><strong>@item.Title</strong><span>@item.Description.In(Culture)</span></div>
            }
        }</div>
    </section>
    <section class="page-shell v2-section v2-split" id="contact">
        <h2>@T("Get in touch", "لنتواصل")</h2>
        <div class="project-actions"><a class="button button-primary" href="mailto:aboodtalat123@gmail.com">@T("Email me", "راسلني")</a><a class="button button-secondary" href="https://www.linkedin.com/in/abd-alrahman-talat-abusalem-1115a23a7/">LinkedIn ↗</a></div>
    </section>
</main>
<PortfolioFooter Culture="@Culture" />

@code {
    [SupplyParameterFromQuery(Name = "lang")] public string? Language { get; set; }
    private string Culture => string.Equals(Language, "ar", StringComparison.OrdinalIgnoreCase) ? "ar" : "en";
    private string T(string en, string ar) => Culture == "ar" ? ar : en;
    private string Url(string path) => Culture == "ar" ? path + "?lang=ar" : path;
}
