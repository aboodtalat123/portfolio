    private string MetaKeywords => T(
        "ABD ALRAHMAN TALAT ABUSALEM, Abd Alrahman Talat Abu Salem, Abdalrahman Abu Salem, Abdalrahman Talat, aboodtalat, aboodtalat123, .NET backend developer, ASP.NET Core developer, Blazor developer, applied AI engineer, AI website assistant, Gaza developer, Palestinian software developer",
        "عبد الرحمن طلعت أبو سالم, عبدالرحمن أبو سالم, عبود طلعت, aboodtalat, aboodtalat123, مطور .NET, مطور ASP.NET Core, مطور Blazor, مهندس ذكاء اصطناعي تطبيقي, مساعد ذكاء اصطناعي للمواقع, مطور من غزة, مطور فلسطيني");
    private string SiteOrigin
    {
        get
        {
            var uri = new Uri(Navigation.Uri);
            return $"{uri.Scheme}://{uri.Host}{(uri.IsDefaultPort ? string.Empty : $":{uri.Port}")}";
        }
    }
    private string EnglishUrl => $"{SiteOrigin}/";
    private string ArabicUrl => $"{SiteOrigin}/?lang=ar";
    private string CanonicalUrl => IsArabic ? ArabicUrl : EnglishUrl;
    private string JsonLd => System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Person",
        ["name"] = "ABD ALRAHMAN TALAT ABUSALEM",
        ["alternateName"] = new[]
        {
            "aboodtalat",
            "aboodtalat123",
