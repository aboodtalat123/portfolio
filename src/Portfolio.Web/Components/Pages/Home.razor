            "https://www.linkedin.com/in/abd-alrahman-talat-abusalem-1115a23a7/"
        },
        ["mainEntityOfPage"] = CanonicalUrl
    });

    protected override async Task OnParametersSetAsync()
    {
        if (loadedCulture == Culture)
        {
            return;
        }

        loadedCulture = Culture;
        var projects = await ProjectRepository.GetPublishedAsync(Culture);
        productProjects = projects
            .Where(project => project.IsFeatured && project.Slug != "reusable-site-ai")
            .ToArray();
        labProjects = projects.Where(project => !project.IsFeatured).ToArray();
    }

    private string T(string english, string arabic) => IsArabic ? arabic : english;

    private string LocalUrl(string path)
    {
        if (!IsArabic)
        {
            return path;
        }

        var fragmentIndex = path.IndexOf('#');
        var fragment = fragmentIndex >= 0 ? path[fragmentIndex..] : string.Empty;
        var basePath = fragmentIndex >= 0 ? path[..fragmentIndex] : path;
        var separator = basePath.Contains('?') ? '&' : '?';
        return $"{basePath}{separator}lang=ar{fragment}";
    }
